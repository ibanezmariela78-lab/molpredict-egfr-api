modules = ["nodejs-20", "python-3.12", "web"]
objectStorage.defaultBucketID = ""
run = "cd artifacts/molpredict-api && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"

[[artifacts]]
id = "artifacts/api-server"

[deployment]
run = "cd artifacts/molpredict-api && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cairo", "catch2", "comic-neue", "coordgenlibs", "eigen", "glibcLocales", "inchi", "libxcrypt", "maeparser", "rapidjson"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MolPredict EGFR API"

[[workflows.workflow]]
name = "MolPredict EGFR API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/molpredict-api && /home/runner/workspace/.pythonlibs/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 8000
externalPort = 80
